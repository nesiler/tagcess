[Unit]
Description=Publish the tagcess stack helper status at boot (oneshot)
Before=tagcess-hshelper-stack.path

[Service]
Type=oneshot
TimeoutStartSec=120
KillMode=control-group
ExecStart=/usr/local/bin/tagcess-hshelper stack-boot --host-root /var/lib/tagcess-host --stack-dir /etc/tagcess/stack --secrets-dir /etc/tagcess/secrets --headscale-root /var/lib/tagcess-headscale --request-uid 10001

[Install]
WantedBy=multi-user.target
