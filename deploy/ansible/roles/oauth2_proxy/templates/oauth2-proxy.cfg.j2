# Generated by the tagcess installer (oauth2_proxy phase). The client and cookie secrets are files next to this
# one, never values here. Group checks are not configured here: Caddy forward_auth asks /oauth2/auth?allowed_groups=
# (architecture §8.1).
provider = "oidc"
oidc_issuer_url = "{{ zitadel_issuer }}"
client_id = "{{ oauth2_proxy_client_id }}"
client_secret_file = "{{ oauth2_proxy_secret_dir }}/client_secret{{ oauth2_proxy_secret_ref_suffix }}"
cookie_secret_file = "{{ oauth2_proxy_secret_dir }}/cookie_secret{{ oauth2_proxy_secret_ref_suffix }}"
oidc_groups_claim = "groups"
scope = "openid profile email"
http_address = "{{ oauth2_proxy_http_address }}"
upstreams = ["static://202"]
reverse_proxy = true
set_xauthrequest = true
skip_provider_button = true
email_domains = ["*"]
insecure_oidc_allow_unverified_email = {{ oauth2_proxy_allow_unverified_email | bool | lower }}
trusted_proxy_ips = ["127.0.0.1/32", "::1/128"]
{% if oauth2_proxy_effective_profile == 'tagcess' %}
# One shared gate cookie for every site, short lifetime, no silent refresh (decision 3 [K]; F5 I12).
cookie_name = "_tagcess_gate"
cookie_domains = {{ oauth2_proxy_cookie_domains | to_json }}
cookie_secure = true
cookie_samesite = "lax"
cookie_expire = "1h"
cookie_refresh = "0"
whitelist_domains = {{ oauth2_proxy_whitelist_domains | to_json }}
{% else %}
# Today's cookie settings, kept as they are until the switch is confirmed (confirm_oauth2_cookie=yes).
cookie_name = "{{ oauth2_proxy_existing.cookie_name }}"
cookie_domains = {{ oauth2_proxy_existing.cookie_domains | default([]) | to_json }}
cookie_secure = {{ oauth2_proxy_existing.cookie_secure | default(true) | bool | lower }}
cookie_samesite = "{{ oauth2_proxy_existing.cookie_samesite | default('lax') }}"
cookie_expire = "{{ oauth2_proxy_existing.cookie_expire | default('12h') }}"
cookie_refresh = "{{ oauth2_proxy_existing.cookie_refresh | default('0') }}"
whitelist_domains = {{ oauth2_proxy_existing.whitelist_domains | default([]) | to_json }}
{% endif %}
