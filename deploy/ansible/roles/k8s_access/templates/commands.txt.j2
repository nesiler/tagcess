# k8s read-only access for tagcess ({{ install_env }}). Run these yourself with your own kubeconfig; the installer
# applies nothing to the cluster (ADR 0030). No token or CA content is written here, only file names.

# 1. Apply the read-only RBAC manifest (ServiceAccount {{ k8s_sa_namespace }}/{{ k8s_sa_name }}, get/list only):
kubectl --context {{ k8s_context or '<k8s-context>' }} apply -f {{ install_env_dir }}/k8s-rbac.yaml

# 2. A time-limited token for the ServiceAccount (keep the file outside the repo, 0600):
kubectl --context {{ k8s_context or '<k8s-context>' }} -n {{ k8s_sa_namespace }} create token {{ k8s_sa_name }} --duration {{ k8s_sa_credential_ttl }} > <token-file>

# 3. The cluster CA:
kubectl --context {{ k8s_context or '<k8s-context>' }} config view --raw --minify -o jsonpath='{.clusters[0].cluster.certificate-authority-data}' | base64 -d > <ca-file>

# 4. In the tagcess UI (https://{{ tagcess_host }}):
#    /k8s/setup       API {{ k8s_api_url }}, probe policy, namespaces
#    /k8s/connection  tls_server_name {{ k8s_tls_server_name }}; upload <ca-file> and <token-file>
#    Traefik entrypoint {{ traefik_entrypoint }}:{{ traefik_port }} (Ingress annotation traefik.ingress.kubernetes.io/router.entrypoints: {{ traefik_entrypoint }}); site target {{ k8s_target_addr }}

# Undo (yourself): kubectl --context {{ k8s_context or '<k8s-context>' }} delete -f {{ install_env_dir }}/k8s-rbac.yaml
