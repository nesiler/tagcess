# Generated by the tagcess installer (app phase). Change the installer settings and rerun the phase instead of
# editing this file: the next run would replace it.
data_dir: /var/lib/tagcess
k8s_auth_dir: /var/lib/tagcess-credentials
ui:
  socket: /run/tagcess/ui.sock
  socket_group: caddy
  socket_mode: "0660"
hook:
  listen: {{ vpn_tailnet_ip_effective }}:{{ headscale_hook_port }}
  signing_key_file: /etc/tagcess/secrets/webhook-signing-key
{% if (secret_files.groups_signing_key | default('')) != '' %}
  groups_signing_key_file: /etc/tagcess/secrets/groups-signing-key
{% endif %}
headscale:
  socket: {{ headscale_socket }}
hostapply:
  requests_dir: /var/lib/tagcess-headscale/requests
  results_dir: /var/lib/tagcess-headscale/results
zitadel:
  issuer: {{ zitadel_issuer }}
  project_id: "{{ zitadel_project_id }}"
  key_file: /etc/tagcess/secrets/zitadel-key.json
  oauth2_proxy_app: oauth2-proxy
caddy:
  admin_url: {{ caddy_admin_url }}
  caddyfile_path: {{ caddyfile_path }}
dns:
  records_path: {{ tagcess_dns_records_path }}
sync:
  interval: {{ app_sync_interval }}
sites:
  allowed_domains: {{ app_allowed_domains | to_json }}
  allowed_targets: {{ [k8s_tailnet_ip] | to_json }}
{% if app_zitadel_internal_sources | length > 0 %}
  zitadel_internal_sources: {{ app_zitadel_internal_sources | to_json }}
{% endif %}
  acme_email: {{ acme_email }}
  certificates: {{ cert_names | to_json }}
  vpn_address: {{ vpn_tailnet_ip_effective }}
  k8s_upstream: {{ k8s_target_addr }}
  tagcess_host: {{ tagcess_host }}
  seed_file: {{ app_seed_dest }}
{% set gate_upstream = oauth2_proxy_http_address %}
{% if oauth2_proxy_client_id or gate_upstream != '127.0.0.1:4180' %}
gate:
{% if oauth2_proxy_client_id %}
  client_id: "{{ oauth2_proxy_client_id }}"
{% endif %}
{% if gate_upstream != '127.0.0.1:4180' %}
  upstream: "{{ gate_upstream }}"
{% endif %}
{% endif %}
