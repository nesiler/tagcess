# Generated by the tagcess installer (app phase), from deploy/compose.yaml (architecture §8, ADR 0004). The image is
# built with the host's caddy/headscale GIDs before this file is used, so there is no build section here.
services:
  tagcess:
    image: {{ tagcess_image }}
    container_name: tagcess
    network_mode: host
    read_only: true
    restart: unless-stopped
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    tmpfs:
      - /tmp
    command: ["-config", "{{ app_config_path }}"]
    volumes:
      - /var/lib/tagcess:/var/lib/tagcess
      - /run/tagcess:/run/tagcess
      - /var/lib/tagcess-credentials:/var/lib/tagcess-credentials
      - {{ caddy_dir }}:{{ caddy_dir }}
      - {{ headscale_socket | dirname }}:{{ headscale_socket | dirname }}
      - /var/lib/tagcess-headscale/requests:/var/lib/tagcess-headscale/requests
      - /var/lib/tagcess-headscale/results:/var/lib/tagcess-headscale/results:ro
      - {{ headscale_policy_path }}:{{ headscale_policy_path }}:ro
      - /etc/letsencrypt/live:/etc/letsencrypt/live:ro
      - /etc/letsencrypt/archive:/etc/letsencrypt/archive:ro
      - /etc/tagcess/secrets:/etc/tagcess/secrets:ro
      - {{ app_config_path }}:{{ app_config_path }}:ro
