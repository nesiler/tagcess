# tagcess installer bootstrap (caddy_install). tagcess takes this file over at its first import.
{
	email admin@lab.example.com
}

(k8s) {
	reverse_proxy https://100.64.0.5 {
		header_up Host {http.request.host}
		header_up X-Forwarded-Host {http.request.host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Port 443

		transport http {
			tls_insecure_skip_verify
		}
	}
}

(vpn_site) {
	tls /etc/letsencrypt/live/{args[0]}/fullchain.pem /etc/letsencrypt/live/{args[0]}/privkey.pem

	@tailnet remote_ip 100.64.0.0/10
	handle @tailnet {
		handle /oauth2/* {
			reverse_proxy 127.0.0.1:4180
		}
		handle {
			forward_auth 127.0.0.1:4180 {
				uri /oauth2/auth?allowed_groups={args[1]}
				@giris_yok status 401
				handle_response @giris_yok {
					redir * /oauth2/start?rd={scheme}://{host}{uri}
				}
				@yetki_yok status 403
				handle_response @yetki_yok {
					header Content-Type "text/html; charset=utf-8"
					respond `<!doctype html><html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Erişim yok</title></head><body style="font-family:system-ui,sans-serif;max-width:32rem;margin:15vh auto;padding:0 1rem;text-align:center"><h1 style="font-size:1.4rem">Bu siteye erişim yetkiniz yok</h1><p>Bu site yalnızca yetkili rol sahiplerine açıktır. Hesabınıza yetkili rolün atanmasını isteyin veya başka bir hesapla giriş yapın.</p><p><a href="/oauth2/sign_out?rd=%2F">Başka hesapla giriş yap</a></p></body></html>` 403
				}
			}
			import k8s
		}
	}

	handle {
		import k8s
	}
}

(vpn_site_api) {
	tls /etc/letsencrypt/live/{args[0]}/fullchain.pem /etc/letsencrypt/live/{args[0]}/privkey.pem

	handle @api {
		import k8s
	}

	@tailnet remote_ip 100.64.0.0/10
	handle @tailnet {
		handle /oauth2/* {
			reverse_proxy 127.0.0.1:4180
		}
		handle {
			forward_auth 127.0.0.1:4180 {
				uri /oauth2/auth?allowed_groups={args[1]}
				@giris_yok status 401
				handle_response @giris_yok {
					redir * /oauth2/start?rd={scheme}://{host}{uri}
				}
				@yetki_yok status 403
				handle_response @yetki_yok {
					header Content-Type "text/html; charset=utf-8"
					respond `<!doctype html><html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Erişim yok</title></head><body style="font-family:system-ui,sans-serif;max-width:32rem;margin:15vh auto;padding:0 1rem;text-align:center"><h1 style="font-size:1.4rem">Bu siteye erişim yetkiniz yok</h1><p>Bu site yalnızca yetkili rol sahiplerine açıktır. Hesabınıza yetkili rolün atanmasını isteyin veya başka bir hesapla giriş yapın.</p><p><a href="/oauth2/sign_out?rd=%2F">Başka hesapla giriş yap</a></p></body></html>` 403
				}
			}
			import k8s
		}
	}

	handle {
		import k8s
	}
}

auth.lab.example.com {
	tls /etc/letsencrypt/live/lab.example.com/fullchain.pem /etc/letsencrypt/live/lab.example.com/privkey.pem
	@tailnet remote_ip 100.64.0.0/10
	@serbest remote_ip 10.0.0.0/16 127.0.0.1/32 ::1/128
	@giris path /.well-known/* /oauth/v2/* /oidc/v1/* /ui/v2/login /ui/v2/login/* /ui/login /ui/login/* /assets/v1/*

	handle @tailnet {
		import k8s
	}
	handle @serbest {
		import k8s
	}
	handle @giris {
		import k8s
	}
	handle {
		respond "Forbidden" 403
	}
}

hs.lab.example.com {
	handle {
		reverse_proxy 127.0.0.1:8080
	}
}

import sites/*.caddy
