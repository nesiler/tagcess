package web

import (
	"strings"

	"github.com/nesiler/tagcess/internal/web/ui"
)

// Layout is the shared shell for every page: the sidebar, the top bar (dry-run and pending-change
// pills, theme switch, the signed-in user) and the page body. Assets are served from /static/
// (embedded, no CDN; ADR 0007). The CSRF token is set as hx-headers on <body> so htmx attaches it to
// every request (NFR-03). active is the work area (a Nav Key); the exact sidebar entry comes from
// the request path bound by WithShell.
templ Layout(actor Actor, csrfToken string, active string, title string, body templ.Component) {
	{{ sh := shellFor(ctx, active) }}
	<!DOCTYPE html>
	<html lang="tr" data-theme="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · tagcess</title>
			<link rel="stylesheet" href="/static/tokens.css"/>
			<link rel="stylesheet" href="/static/components.css"/>
			<script src="/static/ui.js"></script>
			<script src="/static/htmx.min.js" defer></script>
		</head>
		<body hx-headers={ csrfHeaders(csrfToken) }>
			<a class="skip-link" href="#main-content">Ana içeriğe geç</a>
			<div class="shell">
				<aside class="sidebar" id="sidebar">
					<nav class="nav" aria-label="ana menü">
						for _, g := range Nav {
							<div class="nav-group">{ g.Label }</div>
							for _, it := range g.Items {
								if it.Href == sh.current {
									<a class="nav-item" href={ templ.SafeURL(it.Href) } aria-current="page">
										@ui.Icon(it.Icon)
										{ it.Label }
									</a>
								} else {
									<a class="nav-item" href={ templ.SafeURL(it.Href) }>
										@ui.Icon(it.Icon)
										{ it.Label }
									</a>
								}
							}
						}
					</nav>
				</aside>
				<div class="main">
					<header class="topbar">
						<button type="button" class="navbtn" data-nav-toggle aria-controls="sidebar" aria-expanded="false" aria-label="Menü">
							@ui.Icon("list")
						</button>
						<a href="/" class="logo" aria-label="tagcess">
							@logo()
						</a>
						if sh.statusErr || sh.status.DryRun || sh.status.Pending > 0 {
							<div class="topbar-status">
								if sh.statusErr {
									<a class="pendpill pendpill-warn" href="/sync"><i></i>sync durumu okunamadı</a>
								} else {
									if sh.status.DryRun {
										<a class="pendpill pendpill-warn" href="/sync"><i></i>dry-run açık</a>
									}
									if sh.status.Pending > 0 {
										<a class="pendpill" href="/sync"><i></i>{ pendingLabel(sh.status.Pending) }</a>
									}
								}
							</div>
						}
						@ui.Btn(ui.B{Kind: ui.Ghost, Type: "button", Icon: "moon", Title: "Açık/koyu tema", Attrs: templ.Attributes{"data-theme-toggle": true, "aria-label": "Açık/koyu tema"}}) {
							<span class="theme-label">Tema</span>
						}
						<details class="menu">
							<summary class="avatar" aria-label="hesap">{ initials(actor) }</summary>
							<ul class="menu-list">
								<li class="menu-who" id="whoami">
									{ actor.Email }
									if len(actor.Groups) > 0 {
										<small>({ strings.Join(actor.Groups, ", ") })</small>
									}
								</li>
								<li><a id="sign-out" href={ templ.SafeURL(SignOutHref) }>Çıkış yap</a></li>
							</ul>
						</details>
					</header>
					<main class="content" id="main-content" tabindex="-1">
						@body
					</main>
				</div>
			</div>
		</body>
	</html>
}

// logo is the tagcess mark: nine dots in a 3x3 grid, the lit ones forming a T, and the wordmark
// "tagcess" set in Figtree Bold and converted to outlines (no font file needed).
templ logo() {
	<svg class="dots" viewBox="0 0 26 26" fill="currentColor" aria-hidden="true"><circle cx="3.87" cy="3.87" r="3.07"></circle><circle cx="13.0" cy="3.87" r="3.07"></circle><circle cx="22.13" cy="3.87" r="3.07"></circle><circle cx="3.87" cy="13.0" r="3.07" opacity=".28"></circle><circle cx="13.0" cy="13.0" r="3.07"></circle><circle cx="22.13" cy="13.0" r="3.07" opacity=".28"></circle><circle cx="3.87" cy="22.13" r="3.07" opacity=".28"></circle><circle cx="13.0" cy="22.13" r="3.07"></circle><circle cx="22.13" cy="22.13" r="3.07" opacity=".28"></circle></svg>
	<svg class="word" viewBox="14 -713 3474 926" fill="currentColor" aria-hidden="true"><path d="M263.2 12Q179.8 12 137.2 -29Q94.6 -70 94.6 -146V-388H14V-500H94.6V-656H226.6V-500H352V-388H226.6V-175.4Q226.6 -142.6 240.6 -126.4Q254.6 -110.2 282.4 -110.2Q292 -110.2 303.8 -114.6Q315.6 -119 328.6 -128L375.2 -29.2Q350.6 -10.8 321.2 0.6Q291.8 12 263.2 12Z M611 12Q521 12 471.5 -28Q422 -68 422 -141Q422 -221 475.5 -261.5Q529 -302 626 -302H744Q737 -348 715 -372.5Q693 -397 652 -397Q620 -397 594 -383Q568 -369 550 -340L434 -380Q448 -412 475 -442.5Q502 -473 545.5 -492.5Q589 -512 652 -512Q728 -512 778.5 -483Q829 -454 853.5 -401.5Q878 -349 877 -277L874 0H751L749 -58Q730 -24 695.5 -6Q661 12 611 12ZM633 -98Q665 -98 691 -113Q717 -128 732 -152Q747 -176 747 -202V-204H672Q607 -204 582 -188.5Q557 -173 557 -145Q557 -123 577 -110.5Q597 -98 633 -98Z M1196.6 213.2Q1139.6 213.2 1095.9 205Q1052.2 196.8 1022 184.1Q991.8 171.4 973.4 158L1024.8 52.2Q1039.2 59.8 1061.9 70.3Q1084.6 80.8 1116.8 88.6Q1149 96.4 1191.2 96.4Q1230.6 96.4 1261.4 80.8Q1292.2 65.2 1309.7 32.8Q1327.2 0.4 1327.2 -49.6V-98Q1302.2 -58.8 1262.1 -36.6Q1222 -14.4 1171 -14.4Q1102 -14.4 1051.3 -44.1Q1000.6 -73.8 972.8 -128.1Q945 -182.4 945 -255.6Q945 -334.2 972.8 -391.5Q1000.6 -448.8 1051.3 -480.4Q1102 -512 1171 -512Q1222 -512 1262.1 -488.7Q1302.2 -465.4 1327.2 -422V-500H1459.2V-54.4Q1459.2 30.2 1427.3 90.4Q1395.4 150.6 1336.5 181.9Q1277.6 213.2 1196.6 213.2ZM1208.8 -125Q1243 -125 1268.3 -142.5Q1293.6 -160 1307.7 -190.4Q1321.8 -220.8 1321.8 -259.8Q1321.8 -299.6 1307.4 -329.8Q1293 -360 1267.7 -377Q1242.4 -394 1207.8 -394Q1172.6 -394 1145.8 -377Q1119 -360 1104 -329.8Q1089 -299.6 1088.4 -259.8Q1089 -220.8 1104.2 -190.4Q1119.4 -160 1146.5 -142.5Q1173.6 -125 1208.8 -125Z M1803.6 12Q1725.6 12 1665 -21.5Q1604.4 -55 1570.2 -114.3Q1536 -173.6 1536 -250Q1536 -327 1570 -386Q1604 -445 1664 -478.5Q1724 -512 1801.6 -512Q1877.4 -512 1939 -474.8Q2000.6 -437.6 2029.4 -368.4L1905.4 -323.6Q1891.4 -352.8 1861.9 -370.4Q1832.4 -388 1795.6 -388Q1759 -388 1731