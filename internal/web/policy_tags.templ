package web

import (
	"fmt"
	"strings"


	"github.com/nesiler/tagcess/internal/web/ui"
)

// The tagOwners and route autoApprovers form cards (F3-024, H-05). Same stateless draft as the
// rules card: every input submits the live textarea text through form="policy-editor". Protected
// server tags get no delete button; the re-approval side effect of autoApprovers is noted on the
// card. Add and edit forms live in dialogs placed before the card's table and callouts, see the
// note in policy_rules.templ.

func routeField(i int, f string) string { return fmt.Sprintf("route_%d_%s", i, f) }

func tagEditID(i int) string   { return fmt.Sprintf("tag-edit-%d", i) }
func routeEditID(i int) string { return fmt.Sprintf("route-edit-%d", i) }

// tagFieldErr and routeFieldErr tell which of the two cards a field error belongs to, so each
// card shows only its own copy of the message.
func tagFieldErr(v policyTagsView) bool { return strings.HasPrefix(v.FieldErr, "tag_") }
func routeFieldErr(v policyTagsView) bool {
	return strings.HasPrefix(v.FieldErr, "route_") || v.FieldErr == "exit_approvers"
}

// quoteJoin renders a string list the way the policy writes it.
func quoteJoin(l []string) string {
	if len(l) == 0 {
		return "[]"
	}
	return `["` + strings.Join(l, `", "`) + `"]`
}

// ownerAttrs is editorAttrs for a field that takes aliases; the suggestions come from MultiSelect.
func ownerAttrs(fieldErr, name string) templ.Attributes {
	return editorAttrs(fieldErr, name, nil)
}

// ownerSep is how owner and approver lists are written in their single-line field (formList).
const ownerSep = ", "

// commaList splits an owner/approver field the way formList reads it.
func commaList(s string) []string {
	var out []string
	for _, p := range strings.Split(s, ",") {
		if p = strings.TrimSpace(p); p != "" {
			out = append(out, p)
		}
	}
	return out
}

// cidrPattern is the browser-side shape of a route (IPv4 or IPv6 CIDR); the server validates it.
const cidrPattern = `[0-9A-Fa-f:.]+/[0-9]{1,3}`

templ PolicyTagsCards(v policyTagsView, editable bool) {
	if v.LoadErr != "" || v.ReadErr != "" {
		@draftFormRecovery(v.Feedback)
	}
	@ui.Card(ui.C{Title: "Tag owner'ları", Desc: "Bir tag'i cihazlara kimin atayabileceği. Korumalı sunucu tag'leri silinemez.", Right: policyTagAddButton(v, editable)}) {
		if editable && v.LoadErr == "" && v.ReadErr == "" {
			@policyTagAddDialog(v)
			for i, row := range v.Tags {
				@policyTagEditDialog(v, i, row)
			}
		}
		if v.General != "" {
			@ui.Callout(ui.N{Tone: ui.Err}) {
				{ v.General }
			}
		}
		if v.Applied != "" {
			@ui.Callout(ui.N{Tone: ui.Info}) {
				{ v.Applied }
			}
		}
		for _, w := range v.Warn {
			@ui.Callout(ui.N{Tone: ui.Warn}) {
				{ w }
			}
		}
		if v.LoadErr != "" {
			@ui.Callout(ui.N{Tone: ui.Warn}) {
				{ v.LoadErr }
			}
		} else if v.ReadErr != "" {
			@ui.Callout(ui.N{Tone: ui.Warn}) {
				tagOwners/autoApprovers bu metinden okunamadı; form kapalı, ham editörü kullanın: { v.ReadErr }
			}
		} else {
			if tagFieldErr(v) {
				@ui.Callout(ui.N{Tone: ui.Err, Title: "Tag değişikliği reddedildi"}) {
					{ v.FieldMsg }
				}
			}
			if len(v.Tags) == 0 {
				@ui.Empty("tag", "tagOwners girdisi yok.", "")
			} else {
				@ui.TableIn() {
					<thead>
						<tr>
							<th scope="col">Tag</th>
							<th scope="col">Owner'lar</th>
							<th scope="col">Node</th>
							<th scope="col" aria-label="İşlemler"></th>
						</tr>
					</thead>
					<tbody>
						for i, row := range v.Tags {
							<tr>
								<td>
									<code>{ row.Tag }</code>
									if row.Protected {
										@ui.StatusText(ui.Info, "korumalı", "")
									}
								</td>
								<td><code>{ quoteJoin(row.Owners) }</code></td>
								<td>{ fmt.Sprint(row.Nodes) }</td>
								@ui.Actions() {
									if editable {
										@ui.Btn(ui.B{Small: true, Type: "button", Icon: "edit", Title: row.Tag + " düzenle/sil", Attrs: templ.Attributes{"data-dialog-open": tagEditID(i)}}) {
											Düzenle
										}
									}
								}
							</tr>
						}
					</tbody>
				}
			}
		}
	}
	@ui.Card(ui.C{
		Title: "Route autoApprovers",
		Desc:  "Bu route'ları kimin otomatik onaylayacağı. Kayıtta Headscale eşleşen route ve exit node'ları yeniden onaylayabilir; preview bunu ayrıca not eder.",
		Right: policyRouteAddButton(v, editable),
	}) {
		if v.ReadErr == "" && v.LoadErr == "" {
			if editable {
				@policyRouteAddDialog(v)
				for i, row := range v.Routes {
					@policyRouteEditDialog(v, i, row)
				}
				@policyExitNodeDialog(v)
			}
			if routeFieldErr(v) {
				@ui.Callout(ui.N{Tone: ui.Err, Title: "Route değişikliği reddedildi"}) {
					{ v.FieldMsg }
				}
			}
			if len(v.Routes) == 0 {
				@ui.Empty("link", "autoApprovers.routes girdisi yok.", "")
			} else {
				@ui.TableIn() {
					<thead>
						<tr>
							<th scope="col">Route (CIDR)</th>
							<th scope="col">Approver'lar</th>
							<th scope="col" aria-label="İşlemler"></th>
						</tr>
					</thead>
					<tbody>
						for i, row := range v.Routes {
							<tr>
								<td><code>{ row.CIDR }</code></td>
								<td><code>{ quoteJoin(row.Approvers) }</code></td>
								@ui.Actions() {
									if editable {
										@ui.Btn(ui.B{Small: true, Type: "button", Icon: "edit", Title: row.CIDR + " düzenle/sil", Attrs: templ.Attributes{"data-dialog-open": routeEditID(i)}}) {
											Düzenle
										}
									}
								}
							</tr>
						}
					</tbody>
				}
			}
			@ui.Group("exitNode approver'ları") {
				<p><code>{ quoteJoin(v.Exit) }</code></p>
				if editable {
					@ui.Btn(ui.B{Small: true, Type: "button", Icon: "edit", Title: "exitNode approver'larını düzenle", Attrs: templ.Attributes{"data-dialog-open": "exit-edit"}}) {
						Düzenle
					}
				}
			}
		}
	}
}

// policyTagAddButton and policyRouteAddButton open the add dialogs; they are offered only while
// the forms are open.
templ policyTagAddButton(v policyTagsView, editable bool) {
	if editable && v.LoadErr == "" && v.ReadErr == "" {
		@ui.Btn(ui.B{Small: true, Type: "button", Icon: "plus", Attrs: templ.Attributes{"data-dialog-open": "tag-add"}}) {
			Tag ekle
		}
	}
}

templ policyRouteAddButton(v policyTagsView, editable bool) {
	if editable && v.LoadErr == "" && v.ReadErr == "" {
		@ui.Btn(ui.B{Small: true, Type: "button", Icon: "plus", Attrs: templ.Attributes{"data-dialog-open": "route-add"}}) {
			Route ekle
		}
	}
}

// policyTagAddDialog adds a tag; the owner field starts at group:devops (H-05.1) and an empty owner
// list is refused.
templ policyTagAddDialog(v policyTagsView) {
	@ui.Dialog(ui.D{ID: "tag-add", Open: v.Feedback.Dialog == "tag-add", Title: "Tag ekle", Desc: "Boş owner listesi reddedilir: Headscale kabul etse de kimse tag atayamaz."}) {
		@ui.Field(ui.F{Label: "Tag", For: "tag_new_name", Help: "tag: ile başlar."}) {
			@ui.Input(ui.In{ID: "tag_new_name", Name: "tag_new_name", Value: v.Feedback.value("tag_new_name", ""), Placeholder: "tag:ornek", Pattern: `tag:\S+`, Msg: "tag: ile başlayan bir ad girin (ör. tag:web).", Attrs: editorAttrs(v.FieldErr, "tag_new_name", nil)})
			@fieldError(v.FieldErr, "tag_new_name", v.FieldMsg)
		}
		@ui.Field(ui.F{Label: "Owner'lar", For: "tag_new_owners", Help: "Listeden seçin ya da yazıp Enter'a basın."}) {
			@ui.MultiSelect(ui.MS{ID: "tag_new_owners", Name: "tag_new_owners", Sep: ownerSep, Values: commaList(v.Feedback.value("tag_new_owners", defaultTagOwner)), Options: v.Sug, Attrs: ownerAttrs(v.FieldErr, "tag_new_owners")})
			@fieldError(v.FieldErr, "tag_new_owners", v.FieldMsg)
		}
		@ui.DialogFoot() {
			@ui.Btn(ui.B{Kind: ui.Primary, Attrs: submitAttrs("/headscale/policy/tags/set")}) {
				Ekle
			}
		}
	}
}

// policyTagEditDialog edits a tag's owners or deletes the tag. Deleting a protected server tag is
// refused server-side, so the button is not offered; in-use tags warn before and after.
templ policyTagEditDialog(v policyTagsView, i int, row tagRow) {
	@ui.Dialog(ui.D{ID: tagEditID(i), Open: v.Feedback.Dialog == tagEditID(i), Title: row.Tag + " düzenle/sil"}) {
		<input type="hidden" name={ fmt.Sprintf("tag_%d_name", i) } value={ row.Tag } form="policy-editor"/>
		@ui.Field(ui.F{Label: "Owner'lar", For: fmt.Sprintf("tag_%d_owners", i), Help: "Listeden seçin ya da yazıp Enter'a basın."}) {
			@ui.MultiSelect(ui.MS{ID: fmt.Sprintf("tag_%d_owners", i), Name: fmt.Sprintf("tag_%d_owners", i), Sep: ownerSep, Values: commaList(v.Feedback.value(fmt.Sprintf("tag_%d_owners", i), strings.Join(row.Owners, ", "))), Options: v.Sug, Attrs: ownerAttrs(v.FieldErr, fmt.Sprintf("tag_%d_owners", i))})
			@fieldError(v.FieldErr, fmt.Sprintf("tag_%d_owners", i), v.FieldMsg)
		}
		if row.Protected {
			@ui.Callout(ui.N{Tone: ui.Info}) {
				Korumalı sunucu tag'i: silinemez; owner'ları değiştirilirse group:devops çıkarsa uyarı verilir.
			}
		}
		if row.Nodes > 0 || row.InText {
			@ui.Callout(ui.N{Tone: ui.Warn}) {
				Kullanımda:
				if row.Nodes > 0 {
					{ fmt.Sprint(row.Nodes) } node bu tag'i taşıyor;
				}
				if row.InText {
					policy metninde başka bölümlerde geçiyor;
				}
				silmek doğrulamayı bozabilir — preview denetler.
			}
		}
		@ui.DialogFoot() {
			if !row.Protected {
				@ui.Btn(ui.B{Kind: ui.DangerOutline, Icon: "delete", Name: "tagdel", Value: fmt.Sprint(i), Attrs: submitAttrs("/headscale/policy/tags/delete")}) {
					Sil
				}
			}
			@ui.Btn(ui.B{Kind: ui.Primary, Name: "tagset", Value: fmt.Sprint(i), Attrs: submitAttrs("/headscale/policy/tags/set")}) {
				Güncelle
			}
		}
	}
}

// policyRouteEditDialog edits or deletes one route's approvers.
templ policyRouteEditDialog(v policyTagsView, i int, row routeRow) {
	@ui.Dialog(ui.D{ID: routeEditID(i), Open: v.Feedback.Dialog == routeEditID(i), Title: row.CIDR + " düzenle/sil"}) {
		<input type="hidden" name={ routeField(i, "cidr") } value={ row.CIDR } form="policy-editor"/>
		@ui.Field(ui.F{Label: "Approver'lar", For: routeField(i, "approvers"), Help: "Listeden seçin ya da yazıp Enter'a basın."}) {
			@ui.MultiSelect(ui.MS{ID: routeField(i, "approvers"), Name: routeField(i, "approvers"), Sep: ownerSep, Values: commaList(v.Feedback.value(routeField(i, "approvers"), strings.Join(row.Approvers, ", "))), Options: v.Sug, Attrs: ownerAttrs(v.FieldErr, routeField(i, "approvers"))})
			@fieldError(v.FieldErr, routeField(i, "approvers"), v.FieldMsg)
		}
		@ui.DialogFoot() {
			@ui.Btn(ui.B{Kind: ui.DangerOutline, Icon: "delete", Name: "routedel", Value: fmt.Sprint(i), Attrs: submitAttrs("/headscale/policy/routes/delete")}) {
				Sil
			}
			@ui.Btn(ui.B{Kind: ui.Primary, Name: "routeset", Value: fmt.Sprint(i), Attrs: submitAttrs("/headscale/policy/routes/set")}) {
				Güncelle
			}
		}
	}
}

// policyRouteAddDialog adds a route with its approvers.
templ policyRouteAddDialog(v policyTagsView) {
	@ui.Dialog(ui.D{ID: "route-add", Open: v.Feedback.Dialog == "route-add", Title: "Route ekle"}) {
		@ui.Field(ui.F{Label: "Route (CIDR)", For: "route_new_cidr"}) {
			@ui.Input(ui.In{ID: "route_new_cidr", Name: "route_new_cidr", Value: v.Feedback.value("route_new_cidr", ""), Placeholder: "10.0.0.0/24", Pattern: cidrPattern, Msg: "CIDR biçiminde girin (ör. 10.0.0.0/24).", Attrs: editorAttrs(v.FieldErr, "route_new_cidr", nil)})
			@fieldError(v.FieldErr, "route_new_cidr", v.FieldMsg)
		}
		@ui.Field(ui.F{Label: "Approver'lar", For: "route_new_approvers", Help: "Listeden seçin ya da yazıp Enter'a basın."}) {
			@ui.MultiSelect(ui.MS{ID: "route_new_approvers", Name: "route_new_approvers", Sep: ownerSep, Values: commaList(v.Feedback.value("route_new_approvers", defaultTagOwner)), Options: v.Sug, Attrs: ownerAttrs(v.FieldErr, "route_new_approvers")})
			@fieldError(v.FieldErr, "route_new_approvers", v.FieldMsg)
		}
		@ui.DialogFoot() {
			@ui.Btn(ui.B{Kind: ui.Primary, Attrs: submitAttrs("/headscale/policy/routes/set")}) {
				Ekle
			}
		}
	}
}

// policyExitNodeDialog sets the exitNode approvers.
templ policyExitNodeDialog(v policyTagsView) {
	@ui.Dialog(ui.D{ID: "exit-edit", Open: v.Feedback.Dialog == "exit-edit", Title: "exitNode approver'ları"}) {
		@ui.Field(ui.F{Label: "exitNode approver'ları", For: "exit_approvers", Help: "Listeden seçin ya da yazıp Enter'a basın."}) {
			@ui.MultiSelect(ui.MS{ID: "exit_approvers", Name: "exit_approvers", Sep: ownerSep, Values: commaList(v.Feedback.value("exit_approvers", strings.Join(v.Exit, ", "))), Options: v.Sug, Attrs: ownerAttrs(v.FieldErr, "exit_approvers")})
			@fieldError(v.FieldErr, "exit_approvers", v.FieldMsg)
		}
		@ui.DialogFoot() {
			@ui.Btn(ui.B{Kind: ui.Primary, Attrs: submitAttrs("/headscale/policy/routes/exitnode")}) {
				exitNode'u güncelle
			}
		}
	}
}
