package web

import "github.com/nesiler/tagcess/internal/web/ui"

// SettingsIndexPage is the target of the top navigation's "Ayarlar" entry: one link per settings
// screen, since each work area keeps its own.
templ SettingsIndexPage() {
	@ui.PageHead(ui.H{Title: "Ayarlar"})
	@ui.Card(ui.C{Flush: true}) {
		@ui.LinkList([]ui.Link{
			{Href: "/sites/settings", Icon: "sites", Title: "Site ayarları", Desc: "Tailnet dışı erişim"},
			{Href: "/monitor/settings", Icon: "bell", Title: "İzleme ayarları", Desc: "Kontrol sıklıkları ve uyarı sınırları"},
			{Href: "/headscale/settings", Icon: "settings", Title: "Headscale ayarları", Desc: "Korumalı tag'ler, kilitli testler, config yazma"},
		})
	}
}
