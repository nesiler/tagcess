package web

import "github.com/nesiler/tagcess/internal/web/ui"

// The Headscale settings screen (F3-020): the protected server tags and the locked policy test
// parameters, and the confirmation page of a change that weakens the protection. Every value is
// escaped by templ.

// HSSettingsPage renders the settings screen. Error is a refusal, Notice a result; both sit above
// the forms.
templ HSSettingsPage(v hsSettingsView, csrfToken string) {
	@ui.PageHead(ui.H{Title: "Headscale ayarları", Sub: "Korumalı tag'ler, kilitli testler ve config yazma.", Crumbs: []ui.Crumb{{Label: "Headscale", Href: "/headscale/devices"}, {Label: "Ayarlar"}}})
	@HeadscaleTabs("settings", v.DryRun)
	if v.Error != "" {
		@ui.Callout(ui.N{Tone: ui.Err, Title: "Değişiklik reddedildi; hiçbir şey kaydedilmedi"}) {
			<pre><code>{ v.Error }</code></pre>
		}
	}
	if v.Notice != "" {
		@ui.Callout(ui.N{Tone: ui.OK}) {
			{ v.Notice }
		}
	}
	@ui.Card(ui.C{Title: "Korumalı sunucu tag'leri", Desc: "Bu tag'leri taşıyan node'lar silinemez, expire edilemez ve tag'leri değiştirilemez; kişisel cihazlara da atanamazlar. Liste boş bırakılamaz.", Right: hsDefaultPill(v.TagsDefault)}) {
		if len(v.Tags) > 0 {
			@ui.TableIn() {
				<tbody>
					for _, t := range v.Tags {
						<tr>
							<td><code>{ t }</code></td>
							@ui.Actions() {
								<form method="post" action="/headscale/settings/tags">
									@CSRFField(csrfToken)
									<input type="hidden" name="action" value="remove"/>
									<input type="hidden" name="tag" value={ t }/>
									@ui.Btn(ui.B{Small: true, Kind: ui.DangerOutline}) {
										Çıkar
									}
								</form>
							}
						</tr>
					}
				</tbody>
			}
		} else {
			<p>Korumalı tag yok.</p>
		}
		<form method="post" action="/headscale/settings/tags">
			@CSRFField(csrfToken)
			<input type="hidden" name="action" value="add"/>
			@ui.Field(ui.F{Label: "Yeni tag", For: "tag"}) {
				@ui.Input(ui.In{ID: "tag", Name: "tag", Placeholder: "tag:ad", Required: true, Pattern: hsTagPattern, Msg: "tag: ile başlayan bir ad girin (ör. tag:server)."})
			}
			@ui.BtnRow() {
				@ui.Btn(ui.B{Kind: ui.Primary, Icon: "plus"}) {
					Ekle
				}
			}
		</form>
	}
	@ui.Card(ui.C{Title: "Kilitli test parametreleri", Desc: "Policy'deki kilitli testler (/* tagcess:locked */) bu değerlerden kurulur: devops grubu arayüze, webhook çağıranı webhook portuna, SSH kaynağı SSH hedeflerine erişebilmeli. Yeni değerler önce canlı policy'ye karşı doğrulanır; geçmezse kaydedilmez. Kaydedilen değerler bir sonraki policy kaydında eklenir.", Right: hsDefaultPill(v.LockedDefault)}) {
		<form method="post" action="/headscale/settings/locked">
			@CSRFField(csrfToken)
			@ui.Field(ui.F{Label: "Arayüz kaynağı (devops grubu)", For: "devops_group"}) {
				@ui.Input(ui.In{ID: "devops_group", Name: "devops_group", Value: v.Locked.DevopsGroup})
			}
			@ui.Field(ui.F{Label: "Sunucu tag'i (arayüz ve webhook hedefi)", For: "server_tag"}) {
				@ui.Input(ui.In{ID: "server_tag", Name: "server_tag", Value: v.Locked.ServerTag, Options: v.Tags, Pattern: hsTagPattern, Msg: "tag: ile başlayan bir ad girin."})
			}
			@ui.Field(ui.F{Label: "Arayüz portu", For: "ui_port"}) {
				@ui.Input(ui.In{ID: "ui_port", Name: "ui_port", Type: "number", Value: v.Locked.UIPort, Msg: "1–65535 arasında bir port girin.", Attrs: templ.Attributes{"min": "1", "max": "65535"}})
			}
			@ui.Field(ui.F{Label: "Webhook çağıran tag'i", For: "k8s_tag"}) {
				@ui.Input(ui.In{ID: "k8s_tag", Name: "k8s_tag", Value: v.Locked.K8sTag, Options: v.Tags, Pattern: hsTagPattern, Msg: "tag: ile başlayan bir ad girin."})
			}
			@ui.Field(ui.F{Label: "Webhook portu", For: "webhook_port"}) {
				@ui.Input(ui.In{ID: "webhook_port", Name: "webhook_port", Type: "number", Value: v.Locked.WebhookPort, Msg: "1–65535 arasında bir port girin.", Attrs: templ.Attributes{"min": "1", "max": "65535"}})
			}
			@ui.Field(ui.F{Label: "SSH kaynak grubu", For: "ssh_src"}) {
				@ui.Input(ui.In{ID: "ssh_src", Name: "ssh_src", Value: v.Locked.SSHSrc})
			}
			@ui.Field(ui.F{Label: "SSH portu", For: "ssh_port"}) {
				@ui.Input(ui.In{ID: "ssh_port", Name: "ssh_port", Type: "number", Value: v.Locked.SSHPort, Msg: "1–65535 arasında bir port girin.", Attrs: templ.Attributes{"min": "1", "max": "65535"}})
			}
			@ui.Field(ui.F{Label: "SSH hedef tag'leri", For: "ssh_dst", Help: "Tag yazıp Enter'a basın."}) {
				@ui.MultiSelect(ui.MS{ID: "ssh_dst", Name: "ssh_dst", Values: splitList(v.Locked.SSHDst), Sep: ", ", Options: v.Tags, Placeholder: "tag:server"})
			}
			@ui.BtnRow() {
				@ui.Btn(ui.B{Kind: ui.Primary, Icon: "check"}) {
					Doğrula ve kaydet
				}
			}
		</form>
	}
	@ui.Card(ui.C{Title: "Config yazma switch'i", Desc: "Açıkken devops, Headscale config'indeki allowed_groups değişikliğini tagcess üzerinden yazabilir. Kapalıyken yazma başlatılamaz. Her iki yön de onay ister ve audit'lenir.", Right: hsNotStoredPill(v.ConfigWriteStored)}) {
		if v.ConfigWriteError != "" {
			@ui.Callout(ui.N{Tone: ui.Err}) {
				{ v.ConfigWriteError }
			}
		}
		<form method="post" action="/headscale/settings/config-write">
			@CSRFField(csrfToken)
			@ui.Switch(ui.SW{Name: "enabled", Value: boolValue(!v.ConfigWrite), On: v.ConfigWrite, Label: "Config yazma switch'i", OnText: "açık (config yazması etkin)", OffText: "kapalı (config yazması engelli)"})
		</form>
		if !v.ConfigWrite {
			<p>Lab groups-claim kabul/ret matrisi geçmeden bu switch üretimde açılmaz.</p>
		}
	}
}

// HSSettingsConfirmPage explains a weakening change and posts it back with the confirm flag and the
// base of the value the operator saw. The form carries the full input again; nothing is stored until
// it is posted.
templ HSSettingsConfirmPage(v hsConfirmView, csrfToken string) {
	@ui.PageHead(ui.H{Title: v.Heading, Crumbs: []ui.Crumb{{Label: "Headscale", Href: "/headscale/devices"}, {Label: "Ayarlar", Href: "/headscale/settings"}, {Label: "Onay"}}})
	@HeadscaleTabs("settings", false)
	@ui.Callout(ui.N{Tone: ui.Warn}) {
		{ v.Warning }
		<ul>
			for _, r := range v.Reasons {
				<li>{ r }</li>
			}
		</ul>
	}
	<form method="post" action={ templ.SafeURL(v.Action) } id="confirm-form">
		@CSRFField(csrfToken)
		for _, f := range v.Fields {
			<input type="hidden" name={ f.Name } value={ f.Value }/>
		}
		<input type="hidden" name="base" value={ v.Base }/>
		<input type="hidden" name="confirm" value="1"/>
		@ui.BtnRow() {
			@ui.Btn(ui.B{Kind: ui.Danger}) {
				{ v.ConfirmLabel }
			}
			@ui.Btn(ui.B{Href: "/headscale/settings"}) {
				Vazgeç
			}
		}
	</form>
}

// hsDefaultPill marks a section's values as the built-in default (nothing stored yet).
templ hsDefaultPill(def bool) {
	if def {
		@ui.StatusText(ui.Off, "varsayılan", "")
	}
}

// hsNotStoredPill marks the write switch as the default off when no row is stored yet.
templ hsNotStoredPill(stored bool) {
	if !stored {
		@ui.StatusText(ui.Off, "başlangıçta kapalı", "")
	}
}

// hsTagPattern is the browser-side shape of a tag; the server validates it again.
const hsTagPattern = `tag:[A-Za-z0-9][A-Za-z0-9\-_.]*`

// boolValue is the form value of a switch's target state.
func boolValue(on bool) string {
	if on {
		return "true"
	}
	return "false"
}