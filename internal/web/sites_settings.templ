package web

import "github.com/nesiler/tagcess/internal/web/ui"

// The site settings screens (F2-015): the "outside the tailnet" switch (S-06) and its version-bound
// review. Every value is escaped by templ.

// SiteSettingsPage shows the switch; pressing it starts the review flow for the other state.
templ SiteSettingsPage(v SiteSettingsView, csrfToken string) {
	@ui.PageHead(ui.H{Title: "Site ayarları", Sub: "Tüm siteler için ortak erişim ayarları.", Crumbs: []ui.Crumb{{Label: "Siteler", Href: "/sites"}, {Label: "Ayarlar"}}}) {
		@ui.Btn(ui.B{Href: "/sites"}) {
			Siteler
		}
	}
	if v.GateErr != "" {
		@ui.Callout(ui.N{Tone: ui.Err, Title: "Ayarlar okunamadı"}) {
			{ v.GateErr }
		}
		@ui.Btn(ui.B{Href: "/sites"}) {
			Geri
		}
	} else {
		@ui.Card(ui.C{Title: "Tailnet dışı erişim", Desc: s06Help}) {
			<form method="post" action="/sites/s06/preview">
				@CSRFField(csrfToken)
				@ui.Switch(ui.SW{Name: "s06", Value: s06Value(!v.S06Open), On: v.S06Open, Label: "Tailnet dışı erişim"})
			</form>
		}
	}
}

// s06Help is the tooltip of the "outside the tailnet" switch.
const s06Help = "Açıkken rol kontrollü ve rolsüz siteler tailnet dışından gelen isteklere de açılır. Kapalıyken bu istekler 403 alır; API bypass kuralları her durumda geçerlidir. Değişiklik apply edilmeden önce preview edilir."

// SiteS06ReviewPage shows the diff the key flip would produce and, unless blocked, the approval
// bound to the displayed plan version.
templ SiteS06ReviewPage(v SiteS06ReviewView, csrfToken string) {
	@ui.PageHead(ui.H{Title: "Tailnet dışı erişim", Sub: s06ReviewSub(v.Open, v.Order), Crumbs: []ui.Crumb{{Label: "Siteler", Href: "/sites"}, {Label: "Ayarlar", Href: "/sites/settings"}, {Label: "Değişiklik"}}})
	if v.Open {
		@ui.Callout(ui.N{Tone: ui.Warn, Title: "Tailnet dışı erişim açılacak"}) {
			<p>Rol kontrollü ve rolsüz siteler tailnet dışından gelen isteklere de açılır.</p>
		}
	} else {
		@ui.Callout(ui.N{Tone: ui.Info, Title: "Tailnet dışı erişim kapatılacak"}) {
			<p>Tailnet dışından gelen istekler 403 alır; API bypass kuralları geçerli kalır.</p>
		}
	}
	if v.Blocked != "" {
		@ui.Callout(ui.N{Tone: ui.Err, Title: "Değişiklik mevcut durum yüzünden hesaplanamadı"}) {
			<pre><code>{ v.Blocked }</code></pre>
		}
		@ui.Btn(ui.B{Href: "/sites/settings"}) {
			Geri
		}
	} else {
		@ui.Card(ui.C{Title: "Değişecek dosyalar", Desc: "Apply edilince üretilecek dosyalar ve Zitadel kayıtları."}) {
			@ui.Diff("Caddy", v.Diff.Caddy)
			@ui.Diff("DNS", v.Diff.DNS)
			@ui.Diff("Zitadel", v.Diff.Zitadel)
		}
		@ApplyForm("/sites/s06/approve", csrfToken, []ui.Hidden{{Name: "s06", Value: s06Value(v.Open)}, {Name: "plan_version", Value: v.Version}}, "/sites/settings")
	}
}

// s06Value is the form value of the target key state.
func s06Value(open bool) string {
	if open {
		return "open"
	}
	return "closed"
}

// s06ReviewSub is the review page subtitle; a blocked view carries no order yet.
func s06ReviewSub(open bool, order string) string {
	what := "kapatılacak"
	if open {
		what = "açılacak"
	}
	if order == "" {
		return "Erişim " + what + "."
	}
	return "Erişim " + what + "; apply sırası: " + order + "."
}

// disabledReason is a button's tooltip only while the button is disabled; an enabled button must not
// claim a state it is not in.
func disabledReason(disabled bool, reason string) string {
	if disabled {
		return reason
	}
	return ""
}
