# Generated by tagcess. Do not edit; every apply rewrites this file from the site records.
{
	email admin@example.com
}

(k8s) {
	reverse_proxy https://100.64.0.5 {
		header_up Host {http.request.host}
		header_up X-Forwarded-Host {http.request.host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Port 443

		transport http {
			tls_insecure_skip_verify
		}
	}
}

(vpn_site) {
	tls /etc/letsencrypt/live/{args[0]}/fullchain.pem /etc/letsencrypt/live/{args[0]}/privkey.pem

	@tailnet remote_ip 100.64.0.0/10
	handle @tailnet {
		handle /oauth2/* {
			reverse_proxy 127.0.0.1:4180
		}
		handle {
			forward_auth 127.0.0.1:4180 {
				uri /oauth2/auth?allowed_groups={args[1]}
				@giris_yok status 401
				handle_response @giris_yok {
					redir * /oauth2/start?rd={scheme}://{host}{uri}
				}
				@yetki_yok status 403
				handle_response @yetki_yok {
					header Content-Type "text/html; charset=utf-8"
					respond `<!doctype html><html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Erişim yok</title></head><body style="font-family:system-ui,sans-serif;max-width:32rem;margin:15vh auto;padding:0 1rem;text-align:center"><h1 style="font-size:1.4rem">Bu siteye erişim yetkiniz yok</h1><p>Bu site yalnızca yetkili rol sahiplerine açıktır. Hesabınıza yetkili rolün atanmasını isteyin veya başka bir hesapla giriş yapın.</p><p><a href="/oauth2/sign_out?rd=%2F">Başka hesapla giriş yap</a></p></body></html>` 403
				}
			}
			import k8s
		}
	}

	handle {
		import k8s
	}
}

(vpn_site_api) {
	tls /etc/letsencrypt/live/{args[0]}/fullchain.pem /etc/letsencrypt/live/{args[0]}/privkey.pem

	handle @api {
		import k8s
	}

	@tailnet remote_ip 100.64.0.0/10
	handle @tailnet {
		handle /oauth2/* {
			reverse_proxy 127.0.0.1:4180
		}
		handle {
			forward_auth 127.0.0.1:4180 {
				uri /oauth2/auth?allowed_groups={args[1]}
				@giris_yok status 401
				handle_response @giris_yok {
					redir * /oauth2/start?rd={scheme}://{host}{uri}
				}
				@yetki_yok status 403
				handle_response @yetki_yok {
					header Content-Type "text/html; charset=utf-8"
					respond `<!doctype html><html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Erişim yok</title></head><body style="font-family:system-ui,sans-serif;max-width:32rem;margin:15vh auto;padding:0 1rem;text-align:center"><h1 style="font-size:1.4rem">Bu siteye erişim yetkiniz yok</h1><p>Bu site yalnızca yetkili rol sahiplerine açıktır. Hesabınıza yetkili rolün atanmasını isteyin veya başka bir hesapla giriş yapın.</p><p><a href="/oauth2/sign_out?rd=%2F">Başka hesapla giriş yap</a></p></body></html>` 403
				}
			}
			import k8s
		}
	}

	handle {
		import k8s
	}
}

docs.example.com {
	@api header Authorization *
	import vpn_site_api example.com devops,developer,standart
}

errors.example.com {
	@api expression `header({'Authorization': '*'}) || path_regexp('^/api/[0-9]+/(envelope|store|security)/')`
	import vpn_site_api example.com devops,developer
}

gitlab.internal.example.org {
	tls /etc/letsencrypt/live/internal.example.org/fullchain.pem /etc/letsencrypt/live/internal.example.org/privkey.pem

	reverse_proxy https://100.64.0.5:30443 {
		header_up X-Gitlab-Token "secret token"
		transport http {
			tls_insecure_skip_verify
		}
	}
}

monitor.example.com {
	import vpn_site example.com devops,developer
}

projects-auth.example.com,
storage-api.example.com {
	tls /etc/letsencrypt/live/example.com/fullchain.pem /etc/letsencrypt/live/example.com/privkey.pem

	import k8s
}

projects.example.com {
	redir /setup https://projects.example.com/setup/ 308
	@api expression `header({'Authorization': '*'}) || header({'X-Api-Key': '*'})`
	import vpn_site_api example.com devops,developer,standart
}

status.internal.example.org {
	tls /etc/letsencrypt/live/internal.example.org/fullchain.pem /etc/letsencrypt/live/internal.example.org/privkey.pem

	reverse_proxy http://100.64.0.4:8080
}
