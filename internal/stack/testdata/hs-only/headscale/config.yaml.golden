# Generated by the tagcess host helper when the service is created; later changes go through ADR 0021 patches.
server_url: "https://hs.example.com"
listen_addr: "127.0.0.1:8080"
metrics_listen_addr: "127.0.0.1:9090"
unix_socket: "/var/run/headscale/headscale.sock"
unix_socket_permission: "0770"
noise:
  private_key_path: "/var/lib/headscale/noise_private.key"
prefixes:
  v4: "100.64.0.0/10"
  v6: "fd7a:115c:a1e0::/48"
database:
  type: sqlite
  sqlite:
    path: "/var/lib/headscale/db.sqlite"
derp:
  server:
    enabled: false
    private_key_path: "/var/lib/headscale/derp_server_private.key"
    stun_listen_addr: "0.0.0.0:3478"
  urls:
    - "https://controlplane.tailscale.com/derpmap/default"
policy:
  mode: database
dns:
  magic_dns: true
  base_domain: "vpn.example.net"
  extra_records_path: "/var/lib/tagcess-dns/extra-records.json"
oidc:
  issuer: "https://idp.example.com"
  client_id: "headscale-client"
  client_secret_path: "/etc/headscale/secrets/oidc_client_secret"
  pkce:
    enabled: true
  allowed_groups:
    - "admins"
