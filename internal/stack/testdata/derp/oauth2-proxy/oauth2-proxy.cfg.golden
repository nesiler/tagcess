# Generated by the tagcess host helper. Secrets are read from files, never written here.
http_address = "127.0.0.1:4180"
provider = "oidc"
oidc_issuer_url = "https://idp.example.com"
client_id = "proxy-client"
client_secret_file = "/run/secrets/oauth2-proxy/client_secret"
cookie_secret_file = "/run/secrets/oauth2-proxy/cookie_secret"
cookie_domains = ["example.com"]
cookie_expire = "1h"
cookie_refresh = "0"
redirect_url = "https://auth.example.com/oauth2/callback"
code_challenge_method = "S256"
email_domains = ["*"]
reverse_proxy = true
set_xauthrequest = true
upstreams = ["static://202"]
